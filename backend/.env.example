# Local development only. Never commit backend/.env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=leettrack_app
DB_PASSWORD=CHANGE_ME
DB_NAME=leetcode_tracker
DB_SSL_CA=
DB_SSL_CA_PEM=
# Certificate chain is always verified; set false ONLY if the provider cert lacks the host name (VERIFY_CA mode).
DB_SSL_VERIFY_IDENTITY=true
JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=120
DB_CONNECT_TIMEOUT=8

# --- Demo / small-host tuning (all optional) ---
# Cap on registered accounts (0 or unset = no cap).
MAX_USERS=100
# Raise these if a whole class signs up from one shared campus IP.
# Code defaults: 5 per IP/hour, 40 total/hour, 30 logins per IP/15 min, 8 failures per account/15 min.
RATE_REGISTER_PER_IP=5
RATE_REGISTER_TOTAL=40
RATE_LOGIN_PER_IP=30
RATE_LOGIN_FAILS_PER_ACCOUNT=8
# Password hashing memory (KiB) and how many hashes may run at once. Keep low on a 512 MB host.
ARGON2_MEMORY_KIB=19456
ARGON2_MAX_CONCURRENT=3
